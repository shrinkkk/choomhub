rules_version = '2';

// ChoomHub security rules.
// Model (see docs/ARCHITECTURE.md, "Firestore data model"):
//   users/{uid}                        -> { coupleId }               private pointer to your space
//   users/{uid}/devices/{fid}          -> { platform, updatedAt }    phones registered for pushes (id = FCM installation id)
//   users/{uid}/settings/notifications -> { gestures, snaps, points, moods, meetup, space, focus, updatedAt } which notifications you want
//   couples/{coupleId}                 -> { members, createdBy, createdAt, inviteCode, ids?, vacancy?, closing? }
//       members are account uids; everything below is filed under member ids: ids[uid] if set
//       (someone who left and came back on another account), else the uid. vacancy is the member
//       id of whoever left, kept for them to come back to; closing is set while the last one out
//       deletes everything.
//   invites/{code}                     -> { coupleId, createdBy, expiresAt, usedBy, vacancy? }
//   couples/{coupleId}/names/{namerId} -> { nameForPartner, updatedAt }  the name namerId gives the other
//   couples/{coupleId}/shared/meetup   -> { at, updatedBy, updatedAt }
//   couples/{coupleId}/shared/roles    -> { goodBoy, goodGirl, updatedAt }   uids; who receives which points
//   couples/{coupleId}/moods/{uid}     -> { mood, label, note, updatedAt }  each person's current mood
//   couples/{coupleId}/shared/moodOptions -> { options: [{key, label}], updatedBy, updatedAt }  the space's mood list
//   couples/{coupleId}/gestures/{id}   -> { kind, from, sentAt }     append-only history
//   couples/{coupleId}/snaps/{id}      -> { from, caption, sentAt, width, height, thumb, collections, kept, reactions }
//   couples/{coupleId}/snaps/{id}/image/full -> { data }            the full JPEG
//   couples/{coupleId}/collections/{id} -> { name, createdBy, createdAt, cover? }  Memory Lane; cover is a snap id
//   couples/{coupleId}/points/{id}     -> { from, to, amount (±1..10), reason, at }  append-only points ledger
//   couples/{coupleId}/focus/{uid}     -> { state, bankedMs, focusSince, breakEndsAt, updatedAt }  focus room session
//   couples/{coupleId}/focusTotals/{uid} -> { totalMs, weekMs, weekStart, pointHours }  focus hours so far
//   couples/{coupleId}/shared/jam      -> { url, by, at }  a music jam link left in the record player
//   couples/{coupleId}/shared/cat      -> { activity, since, by }  where the cat went when last tapped
//   couples/{coupleId}/pet/cat         -> the Pet House cat (needs, coins {uid}, bond {uid}, things, gifts...)
//   couples/{coupleId}/petDiary/{id}   -> { text, at, by }  the cat's diary
// Everything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function couplePath(coupleId) { return /databases/$(database)/documents/couples/$(coupleId); }
    function invitePath(code) { return /databases/$(database)/documents/invites/$(code); }
    function isMember(coupleId) {
      return signedIn() && exists(couplePath(coupleId)) && me() in get(couplePath(coupleId)).data.members;
    }
    // A role slot may become me, stay as it was, or be cleared only if it was me ([s] is my member id).
    function slotOk(next, prev, s) {
      return next == s || next == prev || (next == null && prev == s);
    }
    function rolesWriteOk(old, new, s) {
      let nb = new.get('goodBoy', null);
      let ng = new.get('goodGirl', null);
      let ob = old.get('goodBoy', null);
      let og = old.get('goodGirl', null);
      return (nb == s) != (ng == s)
        && slotOk(nb, ob, s) && slotOk(ng, og, s)
        && (nb != s || ob == null || ob == s)
        && (ng != s || og == null || og == s);
    }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /users/{userId} {
      allow get: if signedIn() && me() == userId;
      allow create, update: if signedIn() && me() == userId
        && request.resource.data.keys().hasOnly(['coupleId', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.coupleId == null
            || me() in getAfter(couplePath(request.resource.data.coupleId)).data.members);

      // Your phones. Only you can see or change them; the push Worker reads them
      // with its own server credentials, which rules don't apply to.
      match /devices/{fid} {
        allow read, delete: if signedIn() && me() == userId;
        allow create, update: if signedIn() && me() == userId
          && fid.size() >= 8 && fid.size() <= 64
          && request.resource.data.keys().hasOnly(['platform', 'updatedAt'])
          && request.resource.data.platform == 'android'
          && request.resource.data.updatedAt == request.time;
      }

      match /settings/notifications {
        allow read: if signedIn() && me() == userId;
        allow create, update: if signedIn() && me() == userId
          && request.resource.data.keys().hasOnly(['gestures', 'snaps', 'points', 'moods', 'meetup', 'space', 'focus', 'pet', 'updatedAt'])
          && request.resource.data.get('gestures', true) is bool
          && request.resource.data.get('points', true) is bool
          && request.resource.data.get('snaps', true) is bool
          && request.resource.data.get('moods', true) is bool
          && request.resource.data.get('meetup', true) is bool
          && request.resource.data.get('space', true) is bool
          && request.resource.data.get('focus', true) is bool
          && request.resource.data.get('pet', true) is bool
          && request.resource.data.updatedAt == request.time;
      }
    }

    match /couples/{coupleId} {
      allow get: if isMember(coupleId);

      function coupleData() { return get(couplePath(coupleId)).data; }
      // Who I am in this space: the account I first joined with (see ids above).
      function self() { return coupleData().get('ids', {}).get(me(), me()); }
      // The member ids of whoever is in the space now.
      function memberIds() {
        let c = coupleData();
        let ids = c.get('ids', {});
        return c.members.size() == 1
          ? [ids.get(c.members[0], c.members[0])]
          : [ids.get(c.members[0], c.members[0]), ids.get(c.members[1], c.members[1])];
      }

      // Start a space with only yourself in it; the invite is created in the same batch.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'createdBy', 'createdAt', 'inviteCode'])
        && request.resource.data.members == [me()]
        && request.resource.data.createdBy == me()
        && request.resource.data.createdAt == request.time
        && getAfter(invitePath(request.resource.data.inviteCode)).data.coupleId == coupleId;

      allow update: if signedIn() && (isJoin() || isRejoin() || isInviteRefresh() || isLeave() || isClose());

      // Only the last one in it, once it's marked closing (and everything in it deleted).
      allow delete: if signedIn() && resource.data.members == [me()] && resource.data.get('closing', false) == true;

      // The second person adds themself, consuming the invite in the same batch.
      function isJoin() {
        return resource.data.members.size() == 1
          && resource.data.get('vacancy', null) == null
          && !(me() in resource.data.members)
          && request.resource.data.members == resource.data.members.concat([me()])
          && onlyChanged(['members'])
          && getAfter(invitePath(resource.data.inviteCode)).data.usedBy == me();
      }

      // Coming back after leaving, on any account: you take over the place that was kept.
      function isRejoin() {
        let ids = request.resource.data.get('ids', {});
        return resource.data.members.size() == 1
          && resource.data.get('vacancy', null) != null
          && !(me() in resource.data.members)
          && request.resource.data.members == resource.data.members.concat([me()])
          && ids.diff(resource.data.get('ids', {})).affectedKeys().hasOnly([me()])
          && ids.get(me(), null) == resource.data.vacancy
          && !('vacancy' in request.resource.data)
          && onlyChanged(['members', 'ids', 'vacancy'])
          && getAfter(invitePath(resource.data.inviteCode)).data.usedBy == me();
      }

      // Leaving while your partner stays: your place (member id) is kept for you, and the used
      // code is cleared so their phone makes a fresh one.
      function isLeave() {
        return resource.data.members.size() == 2
          && me() in resource.data.members
          && request.resource.data.members == resource.data.members.removeAll([me()])
          && request.resource.data.vacancy == resource.data.get('ids', {}).get(me(), me())
          && request.resource.data.inviteCode == ''
          && onlyChanged(['members', 'vacancy', 'inviteCode']);
      }

      // The last one out marks it closing, then deletes everything in it.
      function isClose() {
        return resource.data.members == [me()]
          && onlyChanged(['closing'])
          && request.resource.data.closing == true;
      }

      // Everything in a closing space can be deleted by its last member.
      match /{document=**} {
        allow delete: if isMember(coupleId)
          && coupleData().get('closing', false) == true
          && coupleData().members == [me()];
      }

      // While alone, you can swap in a fresh invite (e.g. the old one expired or your partner left).
      function isInviteRefresh() {
        return resource.data.members == [me()]
          && onlyChanged(['inviteCode'])
          && getAfter(invitePath(request.resource.data.inviteCode)).data.coupleId == coupleId;
      }

      match /names/{namerId} {
        allow read: if isMember(coupleId);
        allow create, update: if isMember(coupleId) && self() == namerId
          && request.resource.data.keys().hasOnly(['nameForPartner', 'updatedAt'])
          && request.resource.data.nameForPartner is string
          && request.resource.data.nameForPartner.size() > 0
          && request.resource.data.nameForPartner.size() <= 24
          && request.resource.data.updatedAt == request.time;
      }

      // Each person can only put themself into one role, can't take a role the
      // partner already holds, and can't move or remove the partner.
      match /shared/roles {
        allow read: if isMember(coupleId);
        allow create, update: if isMember(coupleId)
          && request.resource.data.keys().hasOnly(['goodBoy', 'goodGirl', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && rolesWriteOk(resource == null ? {} : resource.data, request.resource.data, self());
      }

      // Your own mood only: a key and label from the mood list, a short optional note.
      match /moods/{uid} {
        allow read: if isMember(coupleId);
        allow create, update: if isMember(coupleId) && self() == uid
          && request.resource.data.keys().hasOnly(['mood', 'label', 'note', 'updatedAt'])
          && request.resource.data.mood is string
          && request.resource.data.mood.size() > 0 && request.resource.data.mood.size() <= 40
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0 && request.resource.data.label.size() <= 24
          && (request.resource.data.get('note', null) == null
              || (request.resource.data.note is string && request.resource.data.note.size() <= 80))
          && request.resource.data.updatedAt == request.time;
      }

      // Gestures are added as yourself and never edited or deleted.
      match /gestures/{gestureId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.keys().hasOnly(['kind', 'from', 'sentAt'])
          && request.resource.data.kind in ['hug', 'forehead_kiss', 'head_pats', 'tomato']
          && request.resource.data.from == self()
          && request.resource.data.sentAt == request.time;
      }

      // Snaps. Sent as yourself; either of you can keep one in collections (and only that
      // can change). Unkept snaps can be removed by either of you: a new snap replaces the
      // sender's last, and a snap taken out of its last collection is deleted for good (the
      // app never deletes anyone's current snap). The picture sits in a sub-document so lists
      // stay small.
      match /snaps/{snapId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.keys().hasOnly(['from', 'caption', 'sentAt', 'width', 'height', 'thumb', 'collections', 'kept'])
          && request.resource.data.from == self()
          && request.resource.data.sentAt == request.time
          && (request.resource.data.caption == null
              || (request.resource.data.caption is string && request.resource.data.caption.size() <= 140))
          && request.resource.data.width is int && request.resource.data.height is int
          && request.resource.data.thumb is bytes && request.resource.data.thumb.size() <= 60000
          && request.resource.data.collections == [] && request.resource.data.kept == false;
        allow update: if isMember(coupleId) && (isKeep() || isReaction());

        function isKeep() {
          return onlyChanged(['collections', 'kept'])
            && request.resource.data.collections is list
            && request.resource.data.collections.size() <= 20
            && request.resource.data.kept == (request.resource.data.collections.size() > 0);
        }

        // Your own reaction only, from the short list (or removed).
        function isReaction() {
          let after = request.resource.data.reactions;
          return onlyChanged(['reactions'])
            && after is map
            && after.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([self()])
            && (!(self() in after) || after[self()] in ['🖤', '🥺', '😭', '😂', '🔥', '🍅']);
        }
        allow delete: if isMember(coupleId) && resource.data.kept == false;

        match /image/{part} {
          function snapPath() { return /databases/$(database)/documents/couples/$(coupleId)/snaps/$(snapId); }
          allow read: if isMember(coupleId);
          allow create: if isMember(coupleId) && part == 'full'
            && request.resource.data.keys().hasOnly(['data'])
            && request.resource.data.data is bytes
            && request.resource.data.data.size() <= 900000
            && getAfter(snapPath()).data.from == self();
          allow delete: if isMember(coupleId) && get(snapPath()).data.kept == false;
        }
      }

      // Points go only to your partner: 1-10 awarded, or 1-10 taken away (negative), and
      // entries can't be edited or deleted. Totals may go below zero.
      match /points/{awardId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.keys().hasOnly(['from', 'to', 'amount', 'reason', 'at'])
          && request.resource.data.from == self()
          && (
            (request.resource.data.to != self() && request.resource.data.to in memberIds())
            || focusPoints(coupleId)
          )
          && request.resource.data.amount is int
          && request.resource.data.amount >= -10 && request.resource.data.amount <= 10
          && request.resource.data.amount != 0
          && (request.resource.data.reason == null
              || (request.resource.data.reason is string && request.resource.data.reason.size() <= 140))
          && request.resource.data.at == request.time;
      }

      match /collections/{collectionId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
          && request.resource.data.createdBy == self()
          && request.resource.data.createdAt == request.time;
        // Rename, or pick the snap shown on top of the stack.
        allow update: if isMember(coupleId)
          && onlyChanged(['name', 'cover'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
          && (request.resource.data.get('cover', null) == null
              || (request.resource.data.cover is string && request.resource.data.cover.size() <= 64));
        // Deleting a collection; the app also deletes snaps that were only in it.
        allow delete: if isMember(coupleId);
      }

      // The mood list both people pick from; either can edit it.
      // Points to yourself only for focus hours: as many as your focus totals count up in
      // the same write.
      function focusPoints(coupleId) {
        let totals = /databases/$(database)/documents/couples/$(coupleId)/focusTotals/$(self());
        let before = exists(totals) ? get(totals).data.pointHours : 0;
        return request.resource.data.to == self()
          && request.resource.data.reason == 'focus hours'
          && request.resource.data.amount > 0
          && getAfter(totals).data.pointHours == before + request.resource.data.amount;
      }

      // Focus room: your own session only.
      match /focus/{uid} {
        allow read: if isMember(coupleId);
        allow create, update: if isMember(coupleId) && self() == uid
          && request.resource.data.keys().hasOnly(['state', 'bankedMs', 'focusSince', 'breakEndsAt', 'breakMs', 'breakSince', 'startTotalMs', 'updatedAt'])
          && request.resource.data.state in ['away', 'focus', 'break']
          && request.resource.data.bankedMs is int
          && request.resource.data.bankedMs >= 0 && request.resource.data.bankedMs <= 172800000
          && (request.resource.data.focusSince == null || request.resource.data.focusSince is timestamp)
          && (request.resource.data.breakEndsAt == null || request.resource.data.breakEndsAt is timestamp)
          && request.resource.data.get('breakMs', 0) is int && request.resource.data.get('breakMs', 0) >= 0
          && (request.resource.data.get('breakSince', null) == null || request.resource.data.breakSince is timestamp)
          && request.resource.data.get('startTotalMs', 0) is int && request.resource.data.get('startTotalMs', 0) >= 0
          && request.resource.data.updatedAt == request.time;
      }

      // Your own focus totals, which only grow (a stretch counts for at most 12 hours), and
      // whole hours turned into points never exceed the hours focused.
      match /focusTotals/{uid} {
        allow read: if isMember(coupleId);
        allow create, update: if isMember(coupleId) && self() == uid
          && request.resource.data.keys().hasOnly(['totalMs', 'weekMs', 'weekStart', 'pointHours'])
          && request.resource.data.totalMs is int && request.resource.data.weekMs is int
          && request.resource.data.pointHours is int
          && request.resource.data.weekMs >= 0 && request.resource.data.weekMs <= request.resource.data.totalMs
          && (request.resource.data.weekStart == null
              || (request.resource.data.weekStart is string && request.resource.data.weekStart.size() == 10))
          && request.resource.data.pointHours * 3600000 <= request.resource.data.totalMs
          && totalsGrowOk();
      }

      function totalsGrowOk() {
        let before = resource == null ? { 'totalMs': 0, 'pointHours': 0 } : resource.data;
        return request.resource.data.totalMs >= before.totalMs
          && request.resource.data.totalMs <= before.totalMs + 43200000
          && request.resource.data.pointHours >= before.pointHours;
      }

      // The jam link: either of you can leave one or take it out.
      match /shared/jam {
        allow read: if isMember(coupleId);
        allow delete: if isMember(coupleId);
        allow create, update: if isMember(coupleId)
          && request.resource.data.keys().hasOnly(['url', 'by', 'at'])
          && request.resource.data.url is string
          && request.resource.data.url.size() <= 500
          && request.resource.data.url.matches('^https?://[^ ]+$')
          && request.resource.data.by == self()
          && request.resource.data.at == request.time;
      }

      // The Pet House cat: one document either of you can change, except that coins and bond are
      // per person and you can only change your own (and never below zero coins).
      match /pet/{doc} {
        allow read: if isMember(coupleId);
        allow create, update: if isMember(coupleId) && doc == 'cat'
          && request.resource.data.keys().hasOnly([
            'name', 'adoptedAt', 'proposedName', 'proposedBy', 'traits', 'favoriteFood', 'dislikedFood',
            'needs', 'weight', 'sickSince', 'medicineLeft', 'lastMedicineDay', 'vetDone', 'muddy', 'nailsAt',
            'outfit', 'owned', 'inventory', 'coins', 'bond', 'streak', 'streakDay', 'counters', 'gifts',
            'pending', 'lastDailyCheck', 'seen', 'coinDay', 'pettingAt', 'updatedAt'])
          && (request.resource.data.get('name', null) == null
              || (request.resource.data.name is string && request.resource.data.name.size() <= 16))
          && ownOnly('coins') && ownOnly('bond')
          && request.resource.data.get('coins', {}).get(self(), 0) >= 0;
      }

      // Only your own entry in a per-person map may change.
      function ownOnly(field) {
        let before = resource == null ? {} : resource.data.get(field, {});
        return request.resource.data.get(field, {}).diff(before).affectedKeys().hasOnly([self()]);
      }

      match /petDiary/{entry} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.keys().hasOnly(['text', 'at', 'by'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 300
          && request.resource.data.by == self()
          && request.resource.data.at == request.time;
      }

      // The cat: either of you can send it somewhere.
      match /shared/cat {
        allow read: if isMember(coupleId);
        allow create, update: if isMember(coupleId)
          && request.resource.data.keys().hasOnly(['activity', 'since', 'by'])
          && request.resource.data.activity in ['fish', 'post', 'guitar', 'window']
          && request.resource.data.since is timestamp
          && request.resource.data.by == self();
      }

      match /shared/moodOptions {
        allow read: if isMember(coupleId);
        allow create, update: if isMember(coupleId)
          && request.resource.data.keys().hasOnly(['options', 'updatedBy', 'updatedAt'])
          && request.resource.data.options is list
          && request.resource.data.options.size() > 0 && request.resource.data.options.size() <= 40
          && request.resource.data.updatedBy == self()
          && request.resource.data.updatedAt == request.time;
      }

      match /shared/meetup {
        allow read: if isMember(coupleId);
        allow create, update: if isMember(coupleId)
          && request.resource.data.keys().hasOnly(['at', 'updatedBy', 'updatedAt'])
          && (request.resource.data.at == null || request.resource.data.at is timestamp)
          && request.resource.data.updatedBy == self()
          && request.resource.data.updatedAt == request.time;
      }
    }

    // Holding the code is what lets you look it up; codes can't be listed or enumerated.
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['coupleId', 'createdBy', 'expiresAt', 'usedBy', 'vacancy'])
        && request.resource.data.createdBy == me()
        && request.resource.data.get('vacancy', null) == getAfter(couplePath(request.resource.data.coupleId)).data.get('vacancy', null)
        && request.resource.data.usedBy == null
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(3, 'd')
        && getAfter(couplePath(request.resource.data.coupleId)).data.members == [me()];
      // Single use, not expired, not by its creator, and only together with joining the couple.
      allow update: if signedIn()
        && resource.data.usedBy == null
        && resource.data.expiresAt > request.time
        && resource.data.createdBy != me()
        && onlyChanged(['usedBy'])
        && request.resource.data.usedBy == me()
        && me() in getAfter(couplePath(resource.data.coupleId)).data.members;
    }
  }
}
