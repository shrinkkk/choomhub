<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Window-level theme only. All real styling happens in Compose
        (core/designsystem). The dark window background prevents a white flash
        while the first frame is drawn.
    -->
    <style name="Theme.ChoomHub" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/choomhub_night</item>
        <item name="android:colorBackground">@color/choomhub_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
